use Test;
use Locale::Dates;

my constant @known-locales = <BG DE EN FR NL PT RU>;

plan 1 + 2 * @known-locales;

is-deeply Locale::Dates.known-locales, @known-locales,
  'are all known locales accounted for';

for @known-locales {
    my $ld = Locale::Dates($_);
    isa-ok $ld, Locale::Dates;
    is $ld.code, $_, "Does '$_' have the right code";
}

